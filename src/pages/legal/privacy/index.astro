---
import LegalShell from '../../../components/LegalShell.astro';
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="隐私政策 - Astria天穹" description="Astria天穹隐私政策。">
	<LegalShell
		title="隐私政策"
		description="这里会承载 Astria天穹的正式隐私政策。当前先放置页面结构，便于域名上线、审核与后续文本替换。"
		items={[
			'我们会把正式政策拆成信息收集、使用目的、本地存储、第三方服务、用户权利和联系方式等章节。',
			'涉及本地处理的数据会优先留在设备端，网页页面不会默认要求用户提交游戏账号密码。',
			'正式文本上线前，这里只作为审核与用户访问的稳定占位页。',
		]}
	/>
</Layout>
